# connector.bulwarkmail.org
#
# Installed as /etc/nginx/sites-available/connector.bulwarkmail.org and
# symlinked into sites-enabled. Same shape as the other Bulwark vhosts on
# mail.rath.li, except that this one serves files instead of proxying a node
# process - the site is a static export.
#
# Two things here are load-bearing rather than cosmetic, and both come from
# the promise that nothing about a visitor is stored on a server we run:
#
#   access_log off   A connector URL carries the target and its parameters -
#                    which extension someone is installing, which folder they
#                    are opening. Logging the request line would put that on
#                    disk, with an address beside it. The site's whole claim
#                    is that it cannot do this, so it must not.
#
#   Content-Security-Policy
#                    connect-src has to be open: the capability probe goes to
#                    whatever instance the visitor typed in, which is the
#                    point of the site. script-src allows 'unsafe-inline'
#                    because Next's hydration payload is a set of inline
#                    <script> blocks - without it the pages render their
#                    loading state and stop. A static export cannot use a
#                    per-request nonce. What it buys back: these pages render
#                    no untrusted content into markup (the error cards name a
#                    bad parameter without ever echoing its value), so there
#                    is no injection point for an inline script to arrive
#                    through. If that ever stops being true, generate the
#                    union of the inline scripts' sha256 hashes at build time
#                    and list those instead - strictly stronger, at the cost
#                    of regenerating this file on every deploy.
#                    Everything else stays closed, because a script running
#                    on this origin is the one thing that could read the
#                    instance list out of storage.

server {
    listen 80;
    listen [::]:80;
    server_name connector.bulwarkmail.org;

    # Also here, not just on 443. Someone who types the address without a
    # scheme arrives on port 80 carrying the whole target in the request line,
    # and the redirect would be logged before it happened.
    access_log off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name connector.bulwarkmail.org;

    ssl_certificate /etc/letsencrypt/live/connector.bulwarkmail.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/connector.bulwarkmail.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    root /opt/bulwarkmail-connector/current;
    index index.html;

    access_log off;
    error_log /var/log/nginx/connector.error.log crit;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src *; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    # A redirector has nothing worth indexing, and a search result pointing at
    # someone's instance link would only confuse.
    add_header X-Robots-Tag "noindex, nofollow" always;

    location /_next/static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /badges/ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        add_header Access-Control-Allow-Origin "*";
    }

    # Both /settings and /settings/ resolve to settings/index.html, served
    # directly. A 301 from one form to the other would work - the query string
    # survives it - but it doubles every visit for no reason.
    location / {
        try_files $uri $uri/index.html $uri.html =404;
    }

    error_page 404 /404.html;
}

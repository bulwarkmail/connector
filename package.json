{
  "name": "bulwark-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Deep-link redirector that opens a link on your own Bulwark instance",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bulwarkmail/connector.git"
  },
  "scripts": {

    "test": "vitest run",
    "check:privacy": "node scripts/check-privacy.mjs"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
